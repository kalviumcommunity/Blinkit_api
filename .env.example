# Existing PostgreSQL connection details go here. Never use NEXT_PUBLIC_ for this.
DATABASE_URL=postgresql://postgres:password@localhost:5432/blinkit
# A new schema starts with zero products, accounts, and logs.
DATABASE_SCHEMA=blinkit
PORT=3000
# Optional: start an already initialized local PostgreSQL cluster with the app.
# PGDATA=C:/path/to/postgres-data
# PGBIN=C:/Program Files/PostgreSQL/18/bin
# PGPORT=55432
# Set true only when the app is served over HTTPS.
COOKIE_SECURE=false
